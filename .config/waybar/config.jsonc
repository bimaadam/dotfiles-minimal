{
    "layer": "top",
    "position": "top",
    "exclusive": true, // "false" 
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "cpu", "custom/gpu", "memory", "temperature", "custom/weather"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mpris-marquee", "custom/cava", "backlight", "pulseaudio", "bluetooth", "network", "power-profiles-daemon", "image#battery", "custom/dnd", "custom/theme-switch", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": true
    },

    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%",
    },

    "memory": {
        "interval": 1,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB",
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "GPU {}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Intel UHD Graphics: {}%"
    },
    
    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "interval": 1,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "CPU Temp: {temperatureC}°C",
        "on-click": "~/.config/waybar/scripts/toggle-gammastep"
    },
//  "format": "{:%H:%M}",
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S} | {:%d-%m-%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 900,
        "exec": "~/.config/waybar/scripts/weather.py",
        "return-type": "json"
    },

    "custom/mpris-marquee": {
        "exec": "~/.config/waybar/scripts/mpris-marquee.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.py",
        "format": "{}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": true,
        "tooltip-format": "Brightness: {percent}%"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address} ({device_battery_percentage}%)",
        "on-click": "kitty --class blueman-manager -e bluetoothctl",
        "on-click-right": "systemctl is-active --quiet bluetooth && (bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on) || systemctl start bluetooth"
    },

    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  {ifname} (No IP)",
        "format-disconnected": "󰤭  Disconnected",
        "format-alt": "{icon}  {signalStrength}%",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "max-length": 18,
        "tooltip": true,
        "tooltip-format": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nInterface: {ifname}",
        "on-click": "~/.config/waybar/scripts/rofi-wifi-menu.sh",
        "on-click-right": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        }
    },

    "image#battery": {
        "exec": "~/.config/waybar/scripts/battery-svg.py",
        "size": 44,
        "interval": 2,
        "tooltip": true
    },

    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd.sh",
        "return-type": "json",
        "interval": 2,
        "signal": 9,
        "on-click": "dunstctl set-paused toggle && pkill -RTMIN+9 waybar",
        "on-click-right": "dunstctl history-pop"
    },

    "custom/theme-switch": {
        "format": "󰔎",
        "tooltip": true,
        "tooltip-format": "Current: Default Dark (Pill)\nClick: Switch to macOS Light",
        "on-click": "~/.config/waybar/scripts/switch-theme.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout >/dev/null || wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    }
}
