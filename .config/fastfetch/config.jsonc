{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/pfp.png",
        "type": "auto",
        "width": 26,
        "height": 13,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰅂 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS",
            "keyColor": "34"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "32"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "35"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "36"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "31"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "32"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "35"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "36"
        },
        {
            "type": "disk",
            "key": "󰉉 Disk",
            "keyColor": "31",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "32"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
