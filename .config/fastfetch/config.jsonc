{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "white",
            "2": "38;2;175;175;175",
            "3": "38;2;110;110;110"
        },
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": "  \u001b[38;2;85;85;85m│\u001b[0m  ",
        "color": {
            "keys": "38;2;175;175;175"
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB"
        },
        "key": {
            "type": "icon"
        },
        "percent": {
            "type": 0,
            "color": {
                "green": "38;2;175;175;175",
                "yellow": "38;2;175;175;175",
                "red": "38;2;175;175;175"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "white",
                "at": "38;2;95;95;95",
                "host": "38;2;175;175;175"
            }
        },
        "os",
        "kernel",
        "wm",
        "memory",
        "packages",
        "uptime",
        {
            "type": "custom",
            "format": "\u001b[38;2;65;65;65m■ \u001b[38;2;95;95;95m■ \u001b[38;2;130;130;130m■ \u001b[38;2;165;165;165m■ \u001b[38;2;205;205;205m■ \u001b[38;2;255;255;255m■"
        }
    ]
}
